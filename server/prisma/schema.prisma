// Prisma Schema for Travel With Me - Online Tour Booking Platform
datasource db {
  provider = "postgresql" // Có thể hoán chuyển sang mysql hoặc sqlite
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum TransportType {
  PLANE
  BUS
  TRAIN
  MIXED
}

enum TourType {
  RESORT
  TREKKING
  CULTURAL
  FOOD
  FAMILY
}

enum TourStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ScheduleStatus {
  AVAILABLE
  SOLD_OUT
  CLOSED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  IN_TOUR
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  VNPAY
  MOMO
  ZALOPAY
  STRIPE
  VIETQR
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// 1. Quản lý Người dùng
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String?     @map("password_hash")
  fullName     String      @map("full_name")
  phoneNumber  String?     @map("phone_number")
  avatarUrl    String?     @map("avatar_url")
  role         Role        @default(CUSTOMER)
  status       UserStatus  @default(ACTIVE)
  googleId     String?     @unique @map("google_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  bookings     Booking[]
  reviews      Review[]
  wishlists    Wishlist[]

  @@map("users")
}

// 2. Danh mục & Điểm đến
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  region      String?  // Bắc, Trung, Nam, Quốc tế
  description String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")

  tours       Tour[]

  @@map("categories")
}

// 3. Tour du lịch
model Tour {
  id                  String        @id @default(uuid())
  title               String
  slug                String        @unique
  categoryId          String        @map("category_id")
  departureCity       String        @map("departure_city")
  destinationCity     String        @map("destination_city")
  durationDays        Int           @map("duration_days")
  durationNights      Int           @map("duration_nights")
  transportType       TransportType @default(BUS) @map("transport_type")
  tourType            TourType      @default(RESORT) @map("tour_type")
  overviewDescription String        @map("overview_description") @db.Text
  inclusions          String        @db.Text
  exclusions          String        @db.Text
  cancellationPolicy  String        @map("cancellation_policy") @db.Text
  thumbnailUrl        String        @map("thumbnail_url")
  albumImages         String[]      @map("album_images")
  status              TourStatus    @default(ACTIVE)
  ratingAverage       Float         @default(5.0) @map("rating_average")
  reviewCount         Int           @default(0) @map("review_count")
  isFeatured          Boolean       @default(false) @map("is_featured")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  category            Category      @relation(fields: [categoryId], references: [id])
  schedules           TourSchedule[]
  itineraries         ItineraryDay[]
  reviews             Review[]
  wishlists           Wishlist[]

  @@map("tours")
}

// 4. Lịch trình từng ngày (Itinerary)
model ItineraryDay {
  id          String   @id @default(uuid())
  tourId      String   @map("tour_id")
  dayNumber   Int      @map("day_number") // Ngày 1, Ngày 2...
  title       String   // Tiêu đề chặng
  description String   @db.Text
  activities  String[] // Các hoạt động nổi bật
  meals       String?  // Sáng, Trưa, Tối
  hotel       String?  // Khách sạn lưu trú
  imageUrl    String?  @map("image_url")
  latitude    Float?
  longitude   Float?

  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, dayNumber])
  @@map("itinerary_days")
}

// 5. Lịch khởi hành & Suất đặt (Slots/Inventory)
model TourSchedule {
  id            String         @id @default(uuid())
  tourId        String         @map("tour_id")
  departureDate DateTime       @map("departure_date")
  returnDate    DateTime       @map("return_date")
  adultPrice    Decimal        @map("adult_price") @db.Decimal(12, 2)
  childPrice    Decimal        @map("child_price") @db.Decimal(12, 2)
  infantPrice   Decimal        @map("infant_price") @db.Decimal(12, 2)
  maxCapacity   Int            @map("max_capacity")
  minCapacity   Int            @default(10) @map("min_capacity")
  bookedSlots   Int            @default(0) @map("booked_slots")
  status        ScheduleStatus @default(AVAILABLE)

  tour          Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@map("tour_schedules")
}

// 6. Đơn đặt tour (Booking)
model Booking {
  id              String        @id @default(uuid())
  bookingCode     String        @unique @map("booking_code") // TWM-YYYYMMDD-XXXX
  userId          String?       @map("user_id")
  tourScheduleId  String        @map("tour_schedule_id")
  couponId        String?       @map("couponId")
  
  numAdults       Int           @default(1) @map("num_adults")
  numChildren     Int           @default(0) @map("num_children")
  numInfants      Int           @default(0) @map("num_infants")
  totalPassengers Int           @map("total_passengers")
  
  baseAmount      Decimal       @map("base_amount") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount     Decimal       @map("final_amount") @db.Decimal(12, 2)
  
  contactName     String        @map("contact_name")
  contactEmail    String        @map("contact_email")
  contactPhone    String        @map("contact_phone")
  specialNotes    String?       @map("special_notes") @db.Text
  
  status          BookingStatus @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod @default(VNPAY) @map("payment_method")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  
  qrCodeToken     String        @unique @map("qr_code_token")
  expiresAt       DateTime      @map("expires_at") // Thời hạn giữ chỗ 15-30p
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedule        TourSchedule  @relation(fields: [tourScheduleId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  passengers      BookingPassenger[]
  payments        Payment[]
  review          Review?

  @@map("bookings")
}

// 7. Chi tiết hành khách đi cùng
model BookingPassenger {
  id            String        @id @default(uuid())
  bookingId     String        @map("booking_id")
  fullName      String        @map("full_name")
  passengerType PassengerType @default(ADULT) @map("passenger_type")
  gender        Gender        @default(MALE)
  birthDate     DateTime?     @map("birth_date")
  idCardNumber  String?       @map("id_card_number")

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_passengers")
}

// 8. Lịch sử giao dịch thanh toán
model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @map("booking_id")
  gateway         PaymentMethod
  transactionCode String?       @map("transaction_code")
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  responsePayload Json?         @map("response_payload")
  createdAt       DateTime      @default(now()) @map("created_at")

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// 9. Đánh giá & Nhận xét
model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tourId    String   @map("tour_id")
  bookingId String   @unique @map("booking_id") // Mỗi đơn chỉ đánh giá 1 lần
  rating    Int      // 1 đến 5 sao
  comment   String   @db.Text
  photos    String[] // URLs ảnh thực tế
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// 10. Mã giảm giá (Coupons)
model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  minOrder      Decimal      @default(0) @map("min_order") @db.Decimal(12, 2)
  maxDiscount   Decimal?     @map("max_discount") @db.Decimal(12, 2)
  usageLimit    Int          @default(100) @map("usage_limit")
  usedCount     Int          @default(0) @map("used_count")
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  bookings      Booking[]

  @@map("coupons")
}

// 11. Danh sách yêu thích (Wishlist)
model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tourId    String   @map("tour_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@map("wishlists")
}
